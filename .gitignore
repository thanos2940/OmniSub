# Backend Specific
backend/omnisub_sessions.db
backend/projects/
backend/translation_memory/
backend/test.srt
backend/test_greek_save.py
*.db
*.db-shm
*.db-wal
*.sqlite3
# Runtime state (regenerated at startup; never tracked)
backend/rate_limiter_state.json
backend/agent_runner.json
backend/agent_runner.pid
backend/agent_runner.tmp
backend/library_audit.json
backend/cache/
backend/agent_tasks/
backend/release_version.json
# Single-instance locks of the server and the tray supervisor (a stale one must not dirty the tree:
# the in-app updater refuses to update a dirty checkout).
backend/*.lock
# Migration import staging and the snapshots it takes of what it replaces.
backend/.migration_import_*/
backend/*.pre_import.bak
backend/translation_memory.pre_import.bak/
# The UI build is swapped in next to backend/static by install.ps1 and the updater.
backend/static.new/
backend/static.old/
test_greek.json
config.json
!backend/config.example.json

# Scratch/manual-test output (not part of the test suite — see backend/pytest.ini)
backend/test_output/

# Built frontend copied in by the Docker frontend-builder stage — never tracked.
backend/static/
backend/test_data/

# Electron App
electron-app/node_modules/
electron-app/dist/
*.exe
*.dmg
*.AppImage

# Docker
*.tar.gz
docker-compose.override.yml

# Logs
*.log
logs/

