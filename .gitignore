# OS clutter
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Environment Variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-error.log
yarn-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.development.local
