[
  {
    "id": "﻿1",
    "timecode": "00:01:04,180 --> 00:01:09,220",
    "original": "In the face of absolute despair",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "2",
    "timecode": "00:01:09,520 --> 00:01:13,220",
    "original": "That nearly burned\nour hearts away",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "3",
    "timecode": "00:01:14,720 --> 00:01:19,770",
    "original": "You still found the\ncourage to smile",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "4",
    "timecode": "00:01:20,020 --> 00:01:24,570",
    "original": "Like you accepted it all",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "5",
    "timecode": "00:01:25,370 --> 00:01:27,830",
    "original": "I lost my voice",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "6",
    "timecode": "00:01:28,030 --> 00:01:30,450",
    "original": "And the things I wanted to say",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "7",
    "timecode": "00:01:30,730 --> 00:01:35,700",
    "original": "But every time I\nfell to my knees",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "8",
    "timecode": "00:01:36,050 --> 00:01:40,000",
    "original": "I stood up and kept walking",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "9",
    "timecode": "00:01:40,270 --> 00:01:45,670",
    "original": "We were looking for\nthe ideal white future",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "10",
    "timecode": "00:01:45,880 --> 00:01:50,900",
    "original": "Our one and only hope",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "11",
    "timecode": "00:01:51,230 --> 00:01:53,390",
    "original": "Now I may be left with nothing",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "12",
    "timecode": "00:01:53,560 --> 00:01:58,810",
    "original": "But these raging\nemotions that have",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "13",
    "timecode": "00:01:58,870 --> 00:02:01,910",
    "original": "Nowhere to go",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "14",
    "timecode": "00:02:02,160 --> 00:02:07,160",
    "original": "Still, I'll look for a new dawn",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "15",
    "timecode": "00:02:07,540 --> 00:02:10,570",
    "original": "With more than one right answer",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "16",
    "timecode": "00:02:10,810 --> 00:02:14,400",
    "original": "I won't stop",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "17",
    "timecode": "00:02:14,700 --> 00:02:16,430",
    "original": "Until I find it",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "18",
    "timecode": "00:02:28,670 --> 00:02:33,010",
    "original": "The First Battle",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "19",
    "timecode": "00:22:10,400 --> 00:22:16,539",
    "original": "We didn't understand anything",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "20",
    "timecode": "00:22:16,540 --> 00:22:22,709",
    "original": "My left hand groped for\nthings that vanished to my touch",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "21",
    "timecode": "00:22:22,710 --> 00:22:25,709",
    "original": "A moral conflict",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "22",
    "timecode": "00:22:25,710 --> 00:22:28,510",
    "original": "stays your hand",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "23",
    "timecode": "00:22:28,760 --> 00:22:31,259",
    "original": "and tricks you",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "24",
    "timecode": "00:22:31,260 --> 00:22:33,140",
    "original": "out of your future",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "25",
    "timecode": "00:22:33,390 --> 00:22:40,059",
    "original": "I don't know how\nto protect anyone,",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "26",
    "timecode": "00:22:40,060 --> 00:22:45,860",
    "original": "and my ideals might\nwell be pointless,",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "27",
    "timecode": "00:22:46,070 --> 00:22:54,070",
    "original": "but I want to live my life",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "28",
    "timecode": "00:22:55,070 --> 00:23:00,079",
    "original": "The past repeats before my eyes",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "29",
    "timecode": "00:23:00,080 --> 00:23:07,879",
    "original": "Here I will trust the me\nthat now stands with you",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "30",
    "timecode": "00:23:07,880 --> 00:23:13,969",
    "original": "Until my dream\ncrumbles and withers,",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "31",
    "timecode": "00:23:13,970 --> 00:23:19,599",
    "original": "I hope you will carve\nout paradise with me",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "32",
    "timecode": "00:23:19,600 --> 00:23:23,310",
    "original": "Fight your fate",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "33",
    "timecode": "00:23:37,980 --> 00:23:39,485",
    "original": "Next Time",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  },
  {
    "id": "34",
    "timecode": "00:23:39,486 --> 00:23:40,990",
    "original": "Finding the Will to Fight",
    "translated": "",
    "is_edited": false,
    "needs_review": false
  }
]